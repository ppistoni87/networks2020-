# Environment variables required to compile and run the networks2020 project.
# Copy this file to .env, fill in the paths for your system, then run:
#   source .env

# --- Boost Graph Library ---
# Include directory (usually /usr/include after installing libboost-all-dev)
export BOOST_INCLUDE=/usr/include

# Path to the Boost Graph static library
# On Ubuntu/Debian: /usr/lib/x86_64-linux-gnu/libboost_graph.a
export BOOST_BIN=/usr/lib/x86_64-linux-gnu/libboost_graph.a

# --- IBM CPLEX Optimization Studio ---
# Download from: https://www.ibm.com/products/ilog-cplex-optimization-studio
#
# Include directory (contains ilcplex/cplex.h)
# Example: /opt/ibm/ILOG/CPLEX_Studio129/cplex/include
export CPLEX_INCLUDE=

# Path to the CPLEX static library
# Example: /opt/ibm/ILOG/CPLEX_Studio129/cplex/lib/x86-64_linux/static_pic/libcplex.a
export CPLEX_BIN=
